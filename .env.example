# Meaify environment variables
# Copy to .env.local and fill in the values you have.

# Required for best OCR + chat experience (free tier available)
GROQ_API_KEY=

# Optional failsafe for OCR / text generation
GEMINI_API_KEY=

# Optional — sentence embeddings (all-MiniLM-L6-v2) via Hugging Face
HF_TOKEN=

# SQLite database path (default works for local dev)
DATABASE_URL="file:./prisma/dev.db"

# Optional model overrides
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_WHISPER_MODEL=whisper-large-v3
# GEMINI_MODEL=gemini-2.0-flash
