# Meaify environment variables
# Copy to .env.local and fill in the values you have.
# This app is a single-teacher local tool. Do not expose it publicly
# without an auth gate — it stores student answer photos.

# Primary provider (free tier). Vision model must accept images.
GROQ_API_KEY=

# Failsafe for OCR and text. Recommended even when Groq is set,
# because Groq's vision lineup changes often.
GEMINI_API_KEY=

# Sentence embeddings (all-MiniLM-L6-v2) via Hugging Face. Optional.
HF_TOKEN=

# SQLite database path
DATABASE_URL="file:./prisma/dev.db"

# Uploaded sheet images (never stored as data-URLs in SQLite)
# UPLOADS_DIR=./data/uploads

# Model ids. Confirm on https://console.groq.com/docs/models before pinning.
# llama-3.3-70b-versatile and llama-4-scout left the free tier in 2026.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-2.5-flash

# Hybrid score. Defaults match the original formula. Renormalised if they
# do not sum to 1. Change only after a labeled weight sweep.
# SCORE_SEMANTIC_WEIGHT=0.6
# SCORE_KEYWORD_WEIGHT=0.4
